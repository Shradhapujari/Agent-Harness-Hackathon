# Hush controller
TRUEFORGE_BASE_URL=http://localhost:8790
HUSH_MODEL=openai/gpt-5-6-luna
# terminal | ui. `terminal` is the mode the demo runs in: a TrueForge UI click
# resumes the held tool call itself, so the controller cannot record the
# decision or checkpoint before the tool fires (docs/i2-findings.md). `ui` needs
# an explicit poller wired in; without one it refuses to start rather than
# silently approving through a different channel than the one you asked for.
HUSH_APPROVAL_MODE=terminal

# Local services supplied by Person A
HUSH_BMC_URL=http://127.0.0.1:8100
HUSH_ALERTMANAGER_URL=http://127.0.0.1:9093
HUSH_PROMETHEUS_URL=http://127.0.0.1:9090
HUSH_NETBOX_URL=http://127.0.0.1:8000
# Host port for the NetBox container; move it if 8000 is taken locally, and
# keep HUSH_NETBOX_URL in step. The token is a throwaway for a container that
# holds nothing but seeded demo inventory — it is what infra/docker-compose.yml
# hands NetBox at first boot.
HUSH_NETBOX_PORT=8000
HUSH_NETBOX_TOKEN=hush-local-netbox-token-not-a-secret

# Kubernetes context the kubernetes MCP server talks to; FAKE_K8S=1 runs it
# against an in-memory cluster instead.
HUSH_KUBE_CONTEXT=kind-hush
FAKE_K8S=0
# Read-only Kubernetes API the controller polls in N8. `scripts/mcp-up.sh`
# starts a `kubectl proxy` on HUSH_KUBERNETES_PORT and the controller reads
# HUSH_KUBERNETES_URL; move the port if 8001 is taken locally and keep the two
# in step, or verification polls a port nothing is serving.
HUSH_KUBERNETES_URL=http://127.0.0.1:8001
HUSH_KUBERNETES_PORT=8001

# Never commit real credentials.
MOCK_BMC_USER=root
MOCK_BMC_PASSWORD=replace-with-local-password
